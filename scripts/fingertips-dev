#!/usr/bin/env bash
# fingertips-dev wraps fingertips with repo/debug defaults and adds setup.

set -Eeuo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
export FINGERTIPS_PKG="${FINGERTIPS_PKG:-com.fingertipsmcp.dev}"
export PAPI_PAIRING="${PAPI_PAIRING:-$REPO/.dev/pairing.json}"

# shellcheck source=fingertips disable=SC1091
source "$HERE/fingertips"

# Overwrites USAGE from fingertips; read by usage() defined there.
# shellcheck disable=SC2034
USAGE="\
Usage: $(basename "$0") <command> [<options>]
    pair      - Mint a token and save the pairing file
    server    - Expose the on-device FingertipsMCP server on localhost
    papi      - Call the HTTP/WebSocket API
    session   - Show or end the session papi keeps (session id|end)
    helper    - Start the listener and shell helper over ADB, and wait until it runs
    setup     - Build, install, pair, and start the helper
    help      - Display this text
"

# shellcheck disable=SC2317
command:setup() {
    needs adb

    local PKG="$FINGERTIPS_PKG"
    local build=1
    local arg

    for arg in "$@"; do
        case "$arg" in
            --no-build) build=0 ;;
            *) die "unknown arg $arg" ;;
        esac
    done

    export JAVA_HOME="${JAVA_HOME:-/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home}"
    export ANDROID_HOME="${ANDROID_HOME:-/opt/homebrew/share/android-commandlinetools}"
    export PATH="$ANDROID_HOME/platform-tools:$PATH"

    cd "$REPO"

    if [[ $build == 1 ]]; then
        ./gradlew assembleDebug -q --console=plain
    fi

    wait_until 180 booted || die "No booted device after 180s: $(adb get-state 2>&1 | tr -d '\r')"
    adb install -r -g app/build/outputs/apk/debug/app-debug.apk >/dev/null
    adb shell pm grant "$PKG" android.permission.WRITE_SECURE_SETTINGS

    mkdir -p "$(dirname "$PAPI_PAIRING")"
    command:pair --name dev-setup
    command:server

    # Shell helper: input injection, screencap, and privileged app commands. It detaches, and
    # command:helper dies unless the app then reports it running.
    # shellcheck disable=SC2119 # helper reads $# only to refuse arguments, and setup passes none.
    command:helper
    echo "Ready (pairing in $PAPI_PAIRING; use 'scripts/fingertips-dev papi')"
}

# Whether adb has a device online that has finished booting. adb's errors only mean not yet.
booted() {
    [[ "$(adb get-state 2>/dev/null)" == device ]] \
        && [[ "$(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" == 1 ]]
}

main "$@"
