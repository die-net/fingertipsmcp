#!/usr/bin/env node
// chrome-input-check checks the Chrome DevTools behavior that FingertipsMCP's browser input relies on,
// straight against Chrome on the attached phone, so a Chrome update that changes it shows up.
// It opens its own tabs on a page it serves itself through `adb reverse`, since a document Chrome
// loaded from a server is held in a way about:blank and data: are not. It closes them, and puts the
// screen and foreground app back afterwards.
//
// Usage: scripts/chrome-input-check [--hidden-only]
//   --hidden-only  Skip the checks that wake the screen and bring Chrome to the front.
// Needs adb and Node 22 or later. Exits 0 when Chrome behaves as expected, 1 when it does not,
// and 2 when the run could not finish: a read failed, a wait timed out, or the keyguard kept the
// checks that need Chrome on screen from running.

import { execFileSync } from 'node:child_process';
import { createServer } from 'node:http';

const ANSWER_MS = 3_000;
const DEADLINE_MS = 120_000;
const hiddenOnly = process.argv.includes('--hidden-only');

// The behavior FingertipsMCP was written against (Chrome 109, 133, and 145). Chrome 91 has no hold on a
// first paint, so the checks of dropped input differ there, which FingertipsMCP handles.
const EXPECTED = [
  ['touch while Chrome is hidden', 'no answer, not delivered'],
  ['mouse click on a page Chrome has not drawn', 'answered, not delivered'],
  ['key on a page Chrome has not drawn', 'answered, not delivered'],
  ['inserted text on a page Chrome has not drawn', 'delivered'],
  ['mouse click after inserted text', 'answered, not delivered'],
  ['mouse click after a screenshot request', 'one click'],
  ['key after a screenshot request', 'delivered'],
  ['page after a screenshot request', 'no frame, no paint'],
  ['mouse click on about:blank Chrome has not drawn', 'answered, delivered'],
  ['mouseMoved while Chrome is hidden', 'no answer'],
  ['mouse wheel while Chrome is hidden', 'no answer'],
  ['Target.closeTarget', 'tab gone within 5s'],
  ['held touch after its session closes', 'dropped'],
  ['new tab while Chrome shows', 'Chrome switches to it'],
  ['touch on the tab Chrome shows', 'answered, delivered'],
  ['touch on a background tab while Chrome shows', 'no answer, not delivered'],
  ['mouse click on a background tab while Chrome shows', 'answered, delivered'],
  ['mouse click on a drawn tab after Chrome hides', 'answered, delivered'],
  ['mouse click after that tab loads a new page', 'answered, not delivered'],
];

const PAGE = `<!doctype html>
<meta name=viewport content="width=device-width,initial-scale=1">
<body style="height:5000px;margin:0">
<button style="width:200px;height:120px;margin:40px">go</button>
<input id=f style="display:block;margin:40px">
<script>
  window.hits = [];
  window.drawn = 0;
  for (const t of ['touchstart', 'pointerdown', 'pointermove', 'click', 'wheel', 'keydown'])
    document.addEventListener(t, (e) => hits.push(t), true);
  requestAnimationFrame(function tick() { drawn++; requestAnimationFrame(tick); });
</script>`;
const AT = { x: 140, y: 100 };
const KEY = { key: 'a', code: 'KeyA', windowsVirtualKeyCode: 65, nativeVirtualKeyCode: 65 };

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

function adb(...args) {
  return execFileSync('adb', args, {
    encoding: 'utf8',
    timeout: 10_000,
    stdio: ['ignore', 'pipe', 'pipe'],
  }).trim();
}

function phone() {
  const power = adb('shell', 'dumpsys', 'power');
  const activities = adb('shell', 'dumpsys', 'activity', 'activities');
  return {
    awake: !/mWakefulness=Asleep/.test(power),
    // Android 11 prints `ResumedActivity: ActivityRecord{...}`, later versions
    // `topResumedActivity=ActivityRecord{...}`, as the app's ResumedActivity.kt reads them.
    resumed: (activities.match(/ResumedActivity[:=]\s*ActivityRecord\{\S+ \S+ ([^\s}]+)/) ?? [])[1] ?? '',
  };
}

async function until(check, ms, what) {
  const end = Date.now() + ms;
  while (Date.now() < end) {
    if (await check()) return;
    await sleep(250);
  }
  throw new Error(`Timed out waiting for ${what}`);
}

/** One DevTools WebSocket. call() resolves to the reply, or { timedOut: true } after ms. */
async function connect(port, path) {
  const ws = new WebSocket(`ws://127.0.0.1:${port}${path}`);
  const waiting = new Map();
  let id = 0;
  ws.onmessage = (e) => {
    const m = JSON.parse(e.data);
    waiting.get(m.id)?.(m);
    waiting.delete(m.id);
  };
  await Promise.race([
    new Promise((resolve, reject) => {
      ws.onopen = resolve;
      ws.onerror = () => reject(new Error(`Could not open ${path}`));
    }),
    sleep(ANSWER_MS).then(() => Promise.reject(new Error(`Timed out opening ${path}`))),
  ]);
  return {
    call(method, params = {}, ms = ANSWER_MS) {
      const n = ++id;
      ws.send(JSON.stringify({ id: n, method, params }));
      return Promise.race([
        new Promise((resolve) => waiting.set(n, resolve)),
        sleep(ms).then(() => ({ timedOut: true })),
      ]);
    },
    close: () => ws.close(),
  };
}

const answered = (reply) => (reply.timedOut ? 'no answer' : reply.error ? 'error' : 'answered');
const both = (first, second) => (first === second ? first : `${first}/${second}`);
const delivered = (hits, event) => (hits.split(' ').includes(event) ? 'delivered' : 'not delivered');

async function main(port, pageUrl, observed) {
  const json = async (path) =>
    (await fetch(`http://127.0.0.1:${port}${path}`, { signal: AbortSignal.timeout(ANSWER_MS) })).json();
  const version = await json('/json/version');
  console.log(`${version.Browser} on Android ${adb('shell', 'getprop', 'ro.build.version.release')}`);
  const browser = await connect(port, new URL(version.webSocketDebuggerUrl).pathname);
  const opened = new Set();

  async function newPage(url = pageUrl) {
    const reply = await browser.call('Target.createTarget', { url });
    if (!reply.result) throw new Error(`Target.createTarget: ${JSON.stringify(reply)}`);
    const id = reply.result.targetId;
    opened.add(id);
    const page = await connect(port, `/devtools/page/${id}`);
    await loaded(page, url);
    return { id, page };
  }
  const loaded = (page, url) =>
    until(
      // A page still loading may not answer yet, which is why this is not read().
      async () => {
        const expression = `location.href === ${JSON.stringify(url)} && document.readyState === 'complete'`;
        return (await page.call('Runtime.evaluate', { expression, returnByValue: true }, 1_000)).result?.result?.value === true;
      },
      10_000,
      `${url} to load`,
    );
  // A read that fails must stop the run: an empty answer is what several checks expect.
  const read = async (page, expression, awaitPromise = false) => {
    const reply = await page.call('Runtime.evaluate', { expression, returnByValue: true, awaitPromise });
    const value = reply.result?.result?.value;
    if (value === undefined) throw new Error(`Could not read ${expression}: ${JSON.stringify(reply)}`);
    return value;
  };
  const hits = (page) => read(page, 'hits.join(" ")');
  const touch = (page) =>
    page.call('Input.dispatchTouchEvent', { type: 'touchStart', touchPoints: [AT] });
  const mouse = (page, type, buttons) =>
    page.call('Input.dispatchMouseEvent', { type, ...AT, button: 'left', buttons, clickCount: 1 });
  const key = async (page) => {
    const down = await page.call('Input.dispatchKeyEvent', { type: 'keyDown', ...KEY, text: 'a' });
    await page.call('Input.dispatchKeyEvent', { type: 'keyUp', ...KEY });
    return answered(down);
  };
  // Chrome never answers this on a page it has not drawn.
  const screenshot = (page) => page.call('Page.captureScreenshot', { format: 'jpeg', quality: 0 }, 0);
  const closeAll = async () => {
    for (const id of opened) await browser.call('Target.closeTarget', { targetId: id });
    opened.clear();
  };

  try {
    adb('shell', 'input', 'keyevent', 'KEYCODE_SLEEP');
    await until(() => !phone().awake, 5_000, 'the screen to turn off');

    let { page, id } = await newPage();
    const touched = answered(await touch(page));
    observed.set('touch while Chrome is hidden', `${touched}, ${delivered(await hits(page), 'touchstart')}`);
    page.close();

    ({ page } = await newPage());
    const pressed = answered(await mouse(page, 'mousePressed', 1));
    const released = answered(await mouse(page, 'mouseReleased', 0));
    observed.set('mouse click on a page Chrome has not drawn', `${both(pressed, released)}, ${delivered(await hits(page), 'click')}`);
    await read(page, `document.getElementById('f').focus(), 'focused'`);
    const pressedKey = await key(page);
    observed.set('key on a page Chrome has not drawn', `${pressedKey}, ${delivered(await hits(page), 'keydown')}`);
    await page.call('Input.insertText', { text: 'x' });
    observed.set('inserted text on a page Chrome has not drawn', (await read(page, `document.getElementById('f').value`)) === 'x' ? 'delivered' : 'not delivered');

    // Inserted text gives the page user activation, but Chrome still drops a click.
    const textDown = answered(await mouse(page, 'mousePressed', 1));
    const textUp = answered(await mouse(page, 'mouseReleased', 0));
    observed.set('mouse click after inserted text', `${both(textDown, textUp)}, ${delivered(await hits(page), 'click')}`);

    // What FingertipsMCP does: ask for a screenshot, then press until one lands.
    await screenshot(page);
    await until(async () => {
      await mouse(page, 'mousePressed', 1);
      return (await hits(page)).includes('pointerdown');
    }, 2_000, 'a press to land').catch(() => {});
    await mouse(page, 'mouseReleased', 0);
    const clicks = (await hits(page)).split(' ');
    const once = clicks.filter((t) => t === 'pointerdown').length === 1 && clicks.includes('click');
    observed.set('mouse click after a screenshot request', once ? 'one click' : `hits: ${clicks.join(' ')}`);
    await key(page);
    observed.set('key after a screenshot request', delivered(await hits(page), 'keydown'));
    const drew = await read(page, `drawn > 0 || performance.getEntriesByType('paint').length > 0`);
    observed.set('page after a screenshot request', drew ? 'drew' : 'no frame, no paint');
    observed.set('mouseMoved while Chrome is hidden', answered(await page.call('Input.dispatchMouseEvent', { type: 'mouseMoved', ...AT })));
    observed.set('mouse wheel while Chrome is hidden', answered(await page.call('Input.dispatchMouseEvent', { type: 'mouseWheel', ...AT, deltaX: 0, deltaY: 300 })));
    page.close();

    ({ page } = await newPage('about:blank'));
    await read(page, `window.hits = []; document.addEventListener('click', () => hits.push('click'), true); 'ready'`);
    const blankDown = answered(await mouse(page, 'mousePressed', 1));
    const blankUp = answered(await mouse(page, 'mouseReleased', 0));
    observed.set('mouse click on about:blank Chrome has not drawn', `${both(blankDown, blankUp)}, ${delivered(await hits(page), 'click')}`);
    page.close();

    ({ id } = await newPage());
    await browser.call('Target.closeTarget', { targetId: id });
    opened.delete(id);
    let gone = true;
    await until(async () => !(await json('/json/list')).some((t) => t.id === id), 5_000, 'the tab to close')
      .catch(() => (gone = false));
    observed.set('Target.closeTarget', gone ? 'tab gone within 5s' : 'still listed after 5s');
    await closeAll();

    if (hiddenOnly) return;

    // Leave a touch held while Chrome is hidden, close its session, then show the tab.
    ({ page, id } = await newPage());
    await touch(page);
    page.close();
    adb('shell', 'input', 'keyevent', 'KEYCODE_WAKEUP');
    await until(() => phone().awake, 5_000, 'the screen to turn on');
    if (/isKeyguardShowing=true/.test(adb('shell', 'dumpsys', 'window'))) {
      console.log('The keyguard is up, so the checks that need Chrome on screen could not run.');
      return 'skipped';
    }
    adb('shell', 'am', 'start', '-n', 'com.android.chrome/com.google.android.apps.chrome.Main');
    await until(() => phone().resumed.startsWith('com.android.chrome/'), 5_000, 'Chrome to come to the front');
    await browser.call('Target.activateTarget', { targetId: id });
    const again = await connect(port, `/devtools/page/${id}`);
    await until(async () => (await read(again, 'document.visibilityState')) === 'visible', 5_000, 'the tab to show');
    // A page's event loop runs queued input before its animation frame callbacks, so a held touch
    // that Chrome sends once the tab shows has landed by the second frame after that.
    await read(again, 'new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(() => r(true))))', true);
    observed.set('held touch after its session closes', (await hits(again)).includes('touchstart') ? 'played once shown' : 'dropped');
    again.close();

    // The newest tab is in front, so the first one is a background tab in a visible Chrome.
    const first = await newPage();
    const second = await newPage();
    const firstState = await read(first.page, 'document.visibilityState');
    observed.set('new tab while Chrome shows', firstState === 'hidden' ? 'Chrome switches to it' : 'stays behind');
    const touches = [['touch on the tab Chrome shows', second], ['touch on a background tab while Chrome shows', first]];
    for (const [check, { page }] of touches) {
      const reply = answered(await touch(page));
      await page.call('Input.dispatchTouchEvent', { type: 'touchEnd', touchPoints: [] });
      observed.set(check, `${reply}, ${delivered(await hits(page), 'touchstart')}`);
    }
    // A held touch on the first tab must not count as the click below, so start a fresh session.
    first.page.close();
    const behind = await connect(port, `/devtools/page/${first.id}`);
    await behind.call('Runtime.evaluate', { expression: 'hits.length = 0' });
    const down = answered(await mouse(behind, 'mousePressed', 1));
    const up = answered(await mouse(behind, 'mouseReleased', 0));
    observed.set('mouse click on a background tab while Chrome shows', `${both(down, up)}, ${delivered(await hits(behind), 'click')}`);
    behind.close();

    // A tab Chrome has drawn takes a click after Chrome hides, until it loads another document.
    adb('shell', 'input', 'keyevent', 'KEYCODE_HOME');
    const drawn = second.page;
    // Chrome draws until the tab reports hidden, which comes after Android moves on.
    await until(async () => (await read(drawn, 'document.visibilityState')) === 'hidden', 5_000, 'the tab to hide');
    const hiddenDown = answered(await mouse(drawn, 'mousePressed', 1));
    const hiddenUp = answered(await mouse(drawn, 'mouseReleased', 0));
    observed.set('mouse click on a drawn tab after Chrome hides', `${both(hiddenDown, hiddenUp)}, ${delivered(await hits(drawn), 'click')}`);
    const next = `${pageUrl}?next`;
    await drawn.call('Page.navigate', { url: next });
    await loaded(drawn, next);
    const nextDown = answered(await mouse(drawn, 'mousePressed', 1));
    const nextUp = answered(await mouse(drawn, 'mouseReleased', 0));
    observed.set('mouse click after that tab loads a new page', `${both(nextDown, nextUp)}, ${delivered(await hits(drawn), 'click')}`);
    drawn.close();
  } finally {
    await closeAll().catch(() => {});
    browser.close();
  }
}

if (typeof WebSocket === 'undefined') {
  console.error('chrome-input-check needs Node 22 or later for its built-in WebSocket.');
  process.exit(2);
}

const server = createServer((_, response) => {
  response.setHeader('Content-Type', 'text/html');
  response.end(PAGE);
});
await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));

const before = phone();
const port = adb('forward', 'tcp:0', 'localabstract:chrome_devtools_remote');
const pagePort = adb('reverse', 'tcp:0', `tcp:${server.address().port}`);
let restored = false;
function restore() {
  if (restored) return;
  restored = true;
  try {
    const now = phone();
    if (now.resumed !== before.resumed && !before.resumed.startsWith('com.android.chrome/')) {
      adb('shell', 'input', 'keyevent', 'KEYCODE_HOME');
    }
    if (!before.awake && phone().awake) adb('shell', 'input', 'keyevent', 'KEYCODE_SLEEP');
    if (before.awake && !phone().awake) adb('shell', 'input', 'keyevent', 'KEYCODE_WAKEUP');
  } finally {
    adb('forward', '--remove', `tcp:${port}`);
    adb('reverse', '--remove', `tcp:${pagePort}`);
    server.close();
  }
}
const deadline = setTimeout(() => {
  console.error(`Gave up after ${DEADLINE_MS / 1000}s.`);
  restore();
  process.exit(2);
}, DEADLINE_MS);

const observed = new Map();
let code = 0;
try {
  // Checks that could not run leave Chrome's behavior unknown, so the run did not finish.
  if ((await main(port, `http://127.0.0.1:${pagePort}/`, observed)) === 'skipped') code = 2;
} catch (e) {
  console.error(e.message);
  code = 2;
} finally {
  clearTimeout(deadline);
  restore();
}

for (const [check, expected] of EXPECTED) {
  if (!observed.has(check)) continue;
  const got = observed.get(check);
  if (got !== expected && code === 0) code = 1;
  console.log(`${got === expected ? 'ok  ' : 'DIFF'} ${check}: ${got}${got === expected ? '' : ` (expected ${expected})`}`);
}
process.exit(code);
